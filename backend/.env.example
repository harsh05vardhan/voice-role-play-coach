# Copy this file to ".env" and fill in your values. NEVER commit ".env".

# Free key from https://console.groq.com  (used for the LLM and speech-to-text)
GROQ_API_KEY=

# Local MongoDB, or a free MongoDB Atlas connection string
MONGO_URI=mongodb://localhost:27017
MONGO_DB=roleplay_coach

# Optional overrides
LLM_MODEL=openai/gpt-oss-120b
# STT_MODEL=whisper-large-v3-turbo
# TTS_VOICE=en-US-GuyNeural
